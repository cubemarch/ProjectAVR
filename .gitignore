node_modules/
dist/
*.log

# Generated at first run; keeps the DLNA device id stable across restarts.
.dlna-uuid

# Media is user content, not source.
public/media/*
!public/media/.gitkeep

.DS_Store

# Runtime state: database, dev secrets, uploaded and packaged media.
data/

# Generated by `xcodegen generate` from ios/project.yml. An Xcode project file
# is a merge-hostile blob recording absolute paths and per-machine settings.
ios/*.xcodeproj/
ios/build/
ios/DerivedData/

# Signing is per-developer. Local.xcconfig.example is committed in its place.
ios/Local.xcconfig

# Secrets. `.env.example` is the checked-in template; `.env` is not.
.env
.env.*
!.env.example
