node_modules/
dist/
*.log

# Generated at first run; keeps the DLNA device id stable across restarts.
.dlna-uuid

# Media is user content, not source.
public/media/*
!public/media/.gitkeep

.DS_Store

# Runtime state: database, dev secrets, uploaded and packaged media.
data/

# There is no iOS code here any more. The capture app lives in its own
# repository, and the `ios/` rules that used to sit here went with it — along
# with the untracked Xcode project and Local.xcconfig they were ignoring. If a
# top-level `ios/` reappears in this tree, something has been put back that the
# split was meant to remove; see CLAUDE.md.

# Secrets. `.env.example` is the checked-in template; `.env` is not.
.env
.env.*
!.env.example

# Contentsquare wizard (generated)
.cs-wizard/
