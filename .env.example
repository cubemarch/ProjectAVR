# ProjectAVR — configuration
#
# Copy to `.env` and fill in. Everything here has a working default except the
# identity provider, which deliberately does not: with no provider key the
# server falls back to a stub that approves every document and every face, and
# says so at startup and in the creator portal.
#
# Read by the npm scripts via `node --env-file-if-exists=.env`. Running
# `node server/index.js` by hand does not pick it up — use `npm start` or
# `npm run dev`, or pass the flag yourself.
#
# `npm test` deliberately does not load it. The tests set their own
# environment, and a developer's .env leaking into a test run makes the result
# depend on whose machine it ran on.

# ---------------------------------------------------------------- identity --

# Leave unset for the stub. Setting one provider's API key is enough to select
# it; AVR_IDENTITY_PROVIDER only forces the choice. Setting both keys is an
# error rather than a guess, and a name this server does not know is fatal —
# falling back to the stub on a typo would approve every document and every
# face while reporting itself as working.
# AVR_IDENTITY_PROVIDER=didit
# AVR_DIDIT_API_KEY=...

# Three workflows, created in the Didit console under Application → Workflows.
# They are not interchangeable — see docs/IDENTITY.md.
#
#   enrol     OCR + liveness + face match      (creators, once)
#   faceauth  liveness + face match, no OCR    (creators, each browser session)
#   age       OCR only, NO selfie              (every account, once)
#
# The age workflow must not capture a selfie. It is the one every viewer
# passes, and a workflow that quietly collects a face turns a document check
# for the whole user base into biometric collection for the whole user base.
# None of Didit's stock workflows qualifies: all of them bundle liveness and
# face match, so build it by hand with features [{"feature": "OCR"}] alone.
# Not AGE_ESTIMATION — that infers age from a face.
#
# Confirm what a workflow really runs by reading the `features` array of a
# session created against it, not the console toggles. Two face-related
# settings default to true and cannot be turned off through the v3 API; they
# are inert without a feature that captures a face. See docs/IDENTITY.md.
# AVR_DIDIT_ENROL_WORKFLOW_ID=
# AVR_DIDIT_FACEAUTH_WORKFLOW_ID=
# AVR_DIDIT_AGE_WORKFLOW_ID=

# Didit resolves the face for a faceauth session from `vendor_data`, which
# carries our user id. Nothing is sent in `portrait_image`, so no face is ever
# held on this side — that is the property `db/schema.sql` is protecting, and
# it is the reason the two checks have to be the same vendor.
#
# Do not opt in to biometric template retention in the console. It keeps face
# embeddings after a session is deleted; the default, `delete_with_session`, is
# the one that matches what CONSENT_TEXT promises.

# Persona is still implemented and selectable, but is not the provider in use.
# It never got past two account-level blocks — server-side inquiry creation
# disabled, and a key with no inquiry-template read permission.
# AVR_PERSONA_API_KEY=persona_sandbox_...
# AVR_PERSONA_ENROL_TEMPLATE_ID=itmpl_...
# AVR_PERSONA_FACEAUTH_TEMPLATE_ID=itmpl_...
# AVR_PERSONA_AGE_TEMPLATE_ID=itmpl_...

# No webhook variable is listed here on purpose. `verifyPersonaSignature()`
# exists and is tested, but no webhook route is mounted, so a secret would
# configure nothing. Didit sessions are likewise polled, not pushed. See
# "Known gaps" in docs/IDENTITY.md.

# Refuse any broadcast that is not carrying a per-creator grant, and close
# the catalogue to accounts that have not passed an age check. The server
# refuses to start with this on and the stub selected.
# AVR_IDENTITY_ENFORCE=1

# How long an age check stands before it is asked for again (days).
# AVR_AGE_ASSURANCE_DAYS=730

# Upper bound on a portal unlock (seconds). Normally irrelevant — the token
# lives in sessionStorage and dies with the tab long before this.
# AVR_PORTAL_UNLOCK_TTL=7200

# How long a minted grant stays usable before the face check has to be redone
# (seconds). The window between pressing the button in the browser and the
# camera rolling — long enough to walk to the rig and scan the code, short
# enough that a screen left showing one is not a working credential later.
# AVR_GRANT_TTL=300

# How long after first use a grant may still be presented, to resume a
# broadcast that dropped (seconds). Measured from first use and never
# refreshed, so it bounds the total life of a spent grant. Zero means a lost
# Wi-Fi frame ends the broadcast and the creator walks back to a browser.
# AVR_GRANT_RESUME=90

# -------------------------------------------------------------------- auth --

# Required in production. Generate with:  openssl rand -base64 48
# AVR_JWT_SECRET=

# ------------------------------------------------------------------- serve --

# PORT=8080
# AVR_MEDIA_DIR=./media
# AVR_DB=./data/avr.db

# ----------------------------------------------------------------- delivery --
#
# Packaging and what each headset gets offered. See docs/DELIVERY.md.

# Rungs per uploaded title. Each one is another full encode of the source, so
# this is the main lever on packaging cost.
# AVR_LADDER_RUNGS=5

# `h264,hevc` packages the ladder twice. HEVC carries the same picture at
# roughly 60% of the bitrate, and it is the only way an 8K rung reaches a
# standalone headset - a Quest 3 decodes 8K HEVC and does not decode 8K H.264.
# AVR_PACKAGE_CODECS=h264

# The brand mark burned into every rendition. If the file is missing the title
# is packaged unmarked rather than failing, and the catalog records that.
# AVR_WATERMARK=1
# AVR_WATERMARK_FILE=./art/logo-text.png
# AVR_WATERMARK_OPACITY=0.62

# Raise a decode ceiling this deployment has actually measured. These are
# judgement calls about other people's hardware; a self-hoster who has tested
# their own fleet knows better than the built-in table does.
# AVR_DEVICE_PROFILES={"quest2":{"maxHeight":4320,"maxBitrateKbps":80000}}

# A DLNA Browse request carries no User-Agent, so the ceiling is chosen rather
# than sniffed. SkyBox and Pigasus run on standalone headsets.
# AVR_DLNA_PROFILE=quest2

# --------------------------------------------------------------------- live --

# The shared contribution key, used when enforcement is off. It identifies
# nobody: every phone presents the same secret, so a session cannot be
# attributed to a creator. Generated at random each start if unset.
# AVR_LIVE_KEY=
# AVR_LIVE_PORT=8081

# TLS for the contribution socket. Both must be set or the listener stays
# cleartext and pairing links stop advertising TLS - a phone configured to
# expect it then fails closed with "the server refused an encrypted
# connection", which is the correct behaviour and a confusing one to debug.
# For a private address no CA will issue, generate a self-signed pair and let
# the pairing link carry its pin:
#
#   openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
#     -keyout data/tls/ingest-key.pem -out data/tls/ingest-cert.pem \
#     -subj "/CN=ProjectAVR Live ingest" \
#     -addext "subjectAltName=IP:<lan-ip>,DNS:localhost"
#
# Regenerating the certificate changes the pin, so every saved destination on
# every phone must be paired again.
# AVR_LIVE_TLS_CERT=./data/tls/ingest-cert.pem
# AVR_LIVE_TLS_KEY=./data/tls/ingest-key.pem

# The host a pairing link tells the phone to connect to. Without it the link
# echoes back whatever hostname the browser used, so a creator page opened at
# `localhost:8080` mints a QR code pointing the phone at its own loopback.
# AVR_PUBLIC_INGEST_HOST=192.168.1.110

# ----------------------------------------------------------------- payments --

# `stub` is the only provider implemented, and it is the default. It takes no
# money: every purchase settles immediately and the credits are posted to the
# ledger as if they had been paid for. It says so on the console at startup and
# in the `provider` field of GET /api/credits, so nothing has to guess whether
# the money was real.
#
# An unrecognised name is fatal rather than a fall back to the stub, for the
# same reason the identity provider is: a typo that silently handed out free
# credits while reporting success is worse than a server that will not start.
#
# Credits are integer US cents, one credit to the cent. Dollars exist only in
# the purchase row and the button labels. See docs/MONETISATION.md.
# AVR_PAYMENTS_PROVIDER=stub

# How long a creator's streaming setup confirmation stands before it has to be
# redone (seconds, default 12 hours). It is also cleared on every sign-in,
# sign-out and sign-out-everywhere, and it is held in memory — a restart asks
# every creator to confirm again. This is a ceiling on a session that outlives
# a working rig, not the primary expiry.
# AVR_STREAM_CHECK_TTL=43200
