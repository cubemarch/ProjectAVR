// Per-developer signing settings.
//
//   cp Local.xcconfig.example Local.xcconfig
//
// then fill in your team id below. Local.xcconfig is gitignored; this example
// is committed so a fresh clone knows the file is expected.
//
// Find your team id with:
//
//   security find-certificate -c "Apple Development" -p \
//     | openssl x509 -noout -subject | tr ',' '\n' | grep OU=
//
// A free Apple ID works — add it in Xcode › Settings › Accounts and it becomes
// a "Personal Team". Builds signed that way expire after seven days and have to
// be reinstalled, which is fine for testing.

DEVELOPMENT_TEAM =

// Uncomment and change if `com.projectavr.capture` is already registered to
// another account. With a personal team the bundle identifier has to be unique
// across all of Apple's registered identifiers, so a collision is possible.
// PRODUCT_BUNDLE_IDENTIFIER = com.yourname.avrcapture
