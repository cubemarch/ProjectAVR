<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Privacy manifest.

    Required for App Store submission. Two claims here are substantive rather
    than boilerplate and are worth stating plainly:

    * `NSPrivacyTracking` is false and `NSPrivacyTrackingDomains` is empty
      because the app contains no analytics, no attribution SDK, no advertising
      identifier, and no third-party dependencies of any kind. It talks to
      exactly one network address: the destination its operator configured.

    * `NSPrivacyCollectedDataTypes` is empty because the developer collects
      nothing. The video and sound the operator broadcasts go to the operator's
      own destination and never to us; destinations and their stream keys stay
      on the device, in `UserDefaults` and the Keychain respectively. Nothing
      from the camera or the microphone is written to disk, buffered beyond the
      moment it is encoded, or sent anywhere else.

    If either of those stops being true — an analytics SDK, a crash reporter, a
    hosted relay we run — this file must change in the same commit. A manifest
    that describes a previous version of the app is worse than none.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!--
            UserDefaults. Capture settings and the destination list; read and
            written only by this app, for this app.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>

        <!--
            File timestamps. `DestinationProfile` records when a destination was
            created and last edited, and the configuration import reads a
            document the operator picked.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>

        <!--
            System boot time, via `CACurrentMediaTime` and the presentation
            timestamps on capture buffers. Used to keep the two eyes in step and
            to measure elapsed broadcast time.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
